---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, SITE_DESCRIPTION, GITHUB_URL, PROJECTS } from '../consts';

const num = (i: number) => String(i + 1).padStart(2, '0');
const slug = (href: string) => href.replace(/^\//, '');
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <h1 class="tagline reveal" style="--i: 0">{SITE_DESCRIPTION}</h1>

  {/* The launcher — a ⌘K-style command palette as the centerpiece. This is a
      TOOL surface (you came to jump somewhere), so mono throughout is
      intentional. Progressive enhancement: without JS it is a plain list of
      working links; the script below layers fuzzy filtering + keyboard nav on top.
      Fed by PROJECTS; hrefs are absolute root paths to separate deployments. */}
  <section class="launcher reveal" style="--i: 1" aria-label="Jump to a destination">
    <div class="launcher__prompt">
      <label class="launcher__caret" for="launcher-input" aria-hidden="true">›</label>
      <input
        id="launcher-input"
        class="launcher__input"
        type="text"
        placeholder="jump to…"
        autocomplete="off"
        spellcheck="false"
        aria-label="Filter destinations"
        aria-controls="launcher-list"
      />
      <kbd class="launcher__kbd" data-launcher-hint>/</kbd>
    </div>
    <ul id="launcher-list" class="launcher__list" role="list" aria-label="Destinations">
      {
        PROJECTS.map((p, i) => (
          <li>
            <a
              class="row"
              href={p.href}
              data-search={`${slug(p.href)} ${p.title} ${p.blurb}`.toLowerCase()}
            >
              <span class="row__num">{num(i)}</span>
              <span class="row__main">
                <span class="row__name">{slug(p.href)}</span>
                <span class="row__desc">{p.blurb}</span>
              </span>
              <span class="row__go" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p id="launcher-status" class="sr-only" role="status">{PROJECTS.length} destinations</p>
    <p class="launcher__empty" hidden>
      No destination matches. Try <b>blog</b>, <b>agentic</b>, or <b>today</b>.
    </p>
  </section>

  <p class="bio reveal" style="--i: 2">
    I'm Cameron Sjo — threat modeling for LLM-based systems by day, building
    self-hosted, privacy-first tools the rest of the time. The code is on <a
      href={GITHUB_URL}>GitHub</a>.
  </p>
</BaseLayout>

<script>
  // Fuzzy filtering over ordinary links. The links also work without this.
  const input = document.getElementById('launcher-input') as HTMLInputElement | null;
  const list = document.getElementById('launcher-list');
  if (input && list) {
    const rows = Array.from(list.querySelectorAll<HTMLAnchorElement>('.row'));
    const empty = document.querySelector<HTMLElement>('.launcher__empty');
    const status = document.getElementById('launcher-status');
    const hint = document.querySelector<HTMLElement>('[data-launcher-hint]');
    const items = rows.map((a) => ({
      a,
      li: a.closest('li') as HTMLElement,
      text: a.dataset.search || a.textContent || '',
    }));

    // Subsequence fuzzy score: -1 if not all query chars appear in order;
    // higher score rewards consecutive runs and word-boundary starts.
    function score(query: string, text: string): number {
      if (!query) return 0;
      let qi = 0,
        s = 0,
        streak = 0,
        prev = -2;
      for (let ti = 0; ti < text.length && qi < query.length; ti++) {
        if (text[ti] === query[qi]) {
          streak = ti === prev + 1 ? streak + 1 : 1;
          s += streak * 2;
          if (ti === 0 || text[ti - 1] === ' ' || text[ti - 1] === '-') s += 5;
          prev = ti;
          qi++;
        }
      }
      return qi === query.length ? s : -1;
    }

    function visible(): HTMLAnchorElement[] {
      return Array.from(list!.querySelectorAll<HTMLAnchorElement>('li:not([hidden]) > .row'));
    }

    function render() {
      const q = input!.value.trim().toLowerCase();
      const ranked = items
        .map((it) => ({ it, sc: score(q, it.text) }))
        .filter((x) => x.sc >= 0)
        .sort((a, b) => b.sc - a.sc);
      items.forEach((it) => (it.li.hidden = true));
      ranked.forEach(({ it }) => {
        it.li.hidden = false;
        list!.appendChild(it.li); // reorder by score
      });
      if (empty) empty.hidden = ranked.length > 0;
      if (status) status.textContent = `${ranked.length} ${ranked.length === 1 ? 'destination' : 'destinations'}`;
    }

    input.addEventListener('input', render);

    input.addEventListener('keydown', (e) => {
      const vis = visible();
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        (e.key === 'ArrowDown' ? vis[0] : vis.at(-1))?.focus();
      } else if (e.key === 'Enter') {
        e.preventDefault();
        vis[0]?.click();
      } else if (e.key === 'Escape') {
        if (input!.value) {
          input!.value = '';
          render();
        } else {
          input!.blur();
        }
      }
    });

    // Optional arrow shortcuts move real link focus; Tab and Enter stay native.
    list.addEventListener('keydown', (e) => {
      const vis = visible();
      const index = vis.indexOf(document.activeElement as HTMLAnchorElement);
      if (index < 0 || e.altKey || e.ctrlKey || e.metaKey) return;
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        vis[Math.min(index + 1, vis.length - 1)]?.focus();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (index === 0) input!.focus();
        else vis[index - 1]?.focus();
      } else if (e.key === 'Escape') {
        input!.focus();
      }
    });

    // ⌘K / Ctrl+K opens (focuses) the palette; "/" focuses when not typing.
    document.addEventListener('keydown', (e) => {
      if ((e.key === 'k' || e.key === 'K') && (e.metaKey || e.ctrlKey)) {
        e.preventDefault();
        input!.focus();
        input!.select();
      } else if (
        e.key === '/' &&
        document.activeElement !== input &&
        !(document.activeElement instanceof HTMLInputElement) &&
        !(document.activeElement instanceof HTMLTextAreaElement) &&
        !(document.activeElement as HTMLElement | null)?.isContentEditable
      ) {
        e.preventDefault();
        input!.focus();
      }
    });

    if (hint) hint.textContent = '⌘K';
    render();
  }
</script>

<style>
  /* Tool surface — mono throughout, justified: this is a launcher, not a
     document. Tokens only; the launcher is built from scratch because this
     repo (a downstream Artificer consumer) ships no .palette/.card utility.
     Named .launcher, not .palette — artificer.css defines its own unscoped
     .palette recipe (fixed-position command-palette overlay); Astro's
     scoped <style> would not shield this element from that global rule. */
  /* The page's one <h1>. Mono display type, so it drops the sans body's
     word-spacing: JetBrains Mono already gives each space a full cell, and
     the extra 0.16em reads as double spaces. */
  .tagline {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: clamp(1.35rem, 3.6vw, 1.85rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
    word-spacing: normal;
    color: var(--fg);
    max-width: 30ch;
    margin: var(--s-lg) 0 var(--s-2xl);
    text-wrap: balance;
  }


  /* word-spacing: same reason as .tagline — the launcher's chrome is mono.
     .row__desc restores the body spacing for its sans prose. */
  .launcher {
    word-spacing: normal;
    background: var(--bg-overlay);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color var(--dur-fast) var(--ease);
  }
  .launcher:focus-within {
    border-color: var(--accent);
  }

  .launcher__prompt {
    display: flex;
    align-items: center;
    gap: var(--s-sm);
    padding: var(--s-md) var(--s-lg);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    color: var(--fg-secondary);
  }
  .launcher__caret {
    color: var(--accent);
    font-weight: 700;
  }
  .launcher__input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: none;
    color: var(--fg);
    font-family: var(--font-mono);
  }
  .launcher__input::placeholder {
    color: var(--fg-secondary);
    opacity: 0.7;
  }
  /* Restore a real focus indicator on the input itself — the container's
     :focus-within border shift is a hint, not the focused control's ring. */
  .launcher__input:focus-visible {
    outline: var(--focus-width) solid var(--accent);
    outline-offset: var(--focus-offset);
    border-radius: var(--radius-sm);
  }
  .launcher__kbd {
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 2px 6px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--steel);
    white-space: nowrap;
  }

  .launcher__list {
    list-style: none;
    margin: 0;
    padding: var(--s-xs);
  }
  /* Two-line rows: name over blurb. The single-line layout truncated every
     blurb to a few words at desktop width and dropped it entirely on phones. */
  .row {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    align-items: baseline;
    gap: var(--s-md);
    padding: var(--s-sm) var(--s-md);
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    color: var(--fg);
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease);
  }
  .row:hover,
  .row:focus-visible {
    background: var(--bg-raised);
    text-decoration: none;
  }
  .row__num {
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    color: var(--steel);
  }
  .row__main {
    display: flex;
    flex-direction: column;
    gap: var(--s-xs);
    min-width: 0;
  }
  .row__name {
    font-weight: 700;
    overflow-wrap: anywhere;
    transition: color var(--dur-fast) var(--ease);
  }
  .row:hover .row__name,
  .row:focus-visible .row__name {
    color: var(--accent);
  }
  /* The blurb is prose, so it takes the sans body face. */
  .row__desc {
    font-family: var(--font-sans);
    word-spacing: var(--word-spacing-body);
    font-size: var(--t-body-md-size);
    line-height: 1.45;
    color: var(--fg-secondary);
  }
  .row__go {
    color: var(--steel);
    opacity: 0;
    transition:
      opacity var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }
  .row:hover .row__go,
  .row:focus-visible .row__go {
    opacity: 1;
    color: var(--accent);
    transform: translateX(3px);
  }

  .launcher__empty {
    margin: 0;
    padding: var(--s-md) var(--s-lg);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--fg-secondary);
  }
  .launcher__empty b {
    color: var(--fg);
    font-weight: 700;
  }

  /* Prose — sans body face, per the document-surface default. */
  .bio {
    font-size: var(--t-body-lg-size);
    line-height: 1.6;
    color: var(--fg-secondary);
    max-width: 64ch;
    margin: var(--s-xl) 0 0;
  }
  .bio a {
    color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .launcher,
    .row,
    .row__go {
      transition: none;
    }
    .row__go {
      opacity: 1;
    }
    .row:hover .row__go,
    .row:focus-visible .row__go,
    .row.is-active .row__go {
      transform: none;
    }
  }

  @media (max-width: 520px) {
    .row {
      grid-template-columns: 2rem 1fr auto;
      gap: var(--s-sm);
    }
  }
</style>
