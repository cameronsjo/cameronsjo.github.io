---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ARTIFICER_TIMELINE } from '../data/artificer-timeline';

// Showcase for the Artificer design system. DOCUMENT surface (you came to read),
// so the body runs in the sans face; mono marks identifiers, versions, and the
// component chrome. The page is built WITH Artificer — see § Built with the
// thing it documents — by importing the canonical component library directly.
//
// The vendored copy is imported AFTER BaseLayout (which loads the site's token
// mirror), so the canonical v0.10.1 :root tokens + component classes win HERE
// only. Other routes keep the site's mirrored subset. Theme + fonts already
// match the site, so the existing toggle drives this page too.
import '../styles/vendor/artificer.css';

const TITLE = 'Artificer — a design system for tools';
const DESCRIPTION =
  'Artificer is a dark-first, AuDHD-optimized design system for tools, dashboards, and IDE-adjacent UI — its intent, its components, and how it grew.';
---

<BaseLayout title={TITLE} description={DESCRIPTION}>
  {/* ── Hero ── the one whimsy moment on the page (doctrine: one per view).
      The burnished full stop is part of the mark; it flows with the gradient. */}
  <header class="ad-hero reveal" style="--i: 0">
    <h1 class="ad-hero__mark whimsy whimsy--brand">artificer.</h1>
    <p class="ad-hero__lede">
      A <b class="anchor">dark-first</b> design system for people with a
      <b class="anchor">job to do</b> — tools, dashboards, terminals, the
      IDE-adjacent. Built to get out of the way.
    </p>
  </header>

  {/* ════════════════════════════════════════════════════════════════════
      [OWNER-REVIEW · overshare line] — The maker / archetype voice.
      Craft + voice only; no personal/medical detail beyond the publicly
      stated "AuDHD-optimized" design rationale. Edit or cut at the gate.
      ════════════════════════════════════════════════════════════════════ */}
  <section class="ad-section reveal" style="--i: 1" aria-labelledby="ad-maker">
    <h2 id="ad-maker" class="ad-h2">The maker</h2>
    <div class="ad-prose">
      <p>
        Artificer is named for the old sense of the word — the one who makes
        things work so well they appear to work by <b class="anchor">magic</b>.
        It came from a refusal to <b class="anchor">leave a rough edge alone</b>:
        interfaces that fight the person using them, prose set in monospace,
        status told in colour alone.
      </p>
      <p>
        The ratio is <b class="anchor">30% building, 70% tuning</b>. The finished
        object was never the point — the <b class="anchor">finished feel</b> is.
        So the system is opinionated where it matters and quiet everywhere else.
      </p>
    </div>
  </section>

  {/* ── Intent & rules — limited telling, sourced from the public rules. ── */}
  <section class="ad-section reveal" style="--i: 2" aria-labelledby="ad-intent">
    <h2 id="ad-intent" class="ad-h2">What it is</h2>
    <div class="ad-prose">
      <p>
        It treats the user as a <b class="anchor">peer with a task</b>, not an
        audience to dazzle. The first decision on any screen is its
        <b class="anchor">surface</b>: a <em>tool</em> surface (a console, a
        dashboard) runs in mono and reads like data; a <em>document</em> surface
        (this page) runs in sans and reads like prose. Get that wrong and the
        whole thing feels off.
      </p>
    </div>
    <ul class="ad-rules">
      <li><b>One primary action</b> per view — everything else recedes.</li>
      <li><b>Bold the anchor words</b> — scanning is the reading model, not emphasis.</li>
      <li><b>Tier by action required</b>, not by severity.</li>
      <li><b>Status carries a shape and a word</b> — never colour alone.</li>
      <li><b>Numbers are tabular</b>; lists cap at seven before they need grouping.</li>
      <li><b>Honour reduced motion</b>; 300&nbsp;ms is the ceiling and there is one easing curve.</li>
    </ul>
  </section>

  {/* ── Live component demo — real canonical classes from the vendored CSS.
      Exactly ONE .btn--primary on the whole page lives here (hard rule #3). ── */}
  <section class="ad-section reveal" style="--i: 3" aria-labelledby="ad-demo">
    <h2 id="ad-demo" class="ad-h2">Built with the thing it documents</h2>
    <p class="ad-note">Every control below is a real Artificer component, not a screenshot.</p>

    <div class="ad-demo-block">
      <span class="ad-demo-label">Buttons</span>
      <div class="cluster">
        <button class="btn btn--primary" type="button">Primary</button>
        <button class="btn btn--secondary" type="button">Secondary</button>
        <button class="btn btn--ghost" type="button">Ghost</button>
      </div>
    </div>

    <div class="ad-demo-block">
      <span class="ad-demo-label">Status — tiered by what it needs from you</span>
      <div class="cluster">
        <span class="badge badge--success"><span class="dot dot--success"></span>passed</span>
        <span class="badge badge--attention"><span class="dot dot--attention"></span>throttled</span>
        <span class="badge badge--urgent"><span class="dot dot--urgent"></span>failed</span>
        <span class="badge badge--ghost"><span class="dot"></span>idle</span>
      </div>
    </div>

    <div class="ad-demo-block">
      <span class="ad-demo-label">Cards</span>
      <div class="grid-2" style="--gap: var(--s-md)">
        <div class="card">
          <h3 class="ad-card-title">Deploy pipeline</h3>
          <p class="ad-note">Token-bound surface, raised one step off the page.</p>
        </div>
        <div class="card card--attention">
          <h3 class="ad-card-title">Quota warning</h3>
          <p class="ad-note">The left rule tiers the card without shouting in colour.</p>
        </div>
      </div>
    </div>

    <div class="ad-demo-block">
      <span class="ad-demo-label">Stat pattern</span>
      <div class="kpi-strip">
        <div class="ad-stat">
          <div class="ad-stat__label">Active runs</div>
          <div class="ad-stat__value">42</div>
          <div class="ad-stat__delta">+8 this hour</div>
        </div>
        <div class="ad-stat">
          <div class="ad-stat__label">Success rate</div>
          <div class="ad-stat__value">99.4<span class="ad-stat__unit">%</span></div>
          <div class="ad-stat__delta">+0.2% w/w</div>
        </div>
        <div class="ad-stat">
          <div class="ad-stat__label">P95 latency</div>
          <div class="ad-stat__value">312<span class="ad-stat__unit">ms</span></div>
          <div class="ad-stat__delta ad-stat__delta--worse">+24ms vs. yesterday</div>
        </div>
      </div>
    </div>
  </section>

  {/* ── Evolution timeline — version-anchored milestones (see data file).
      Some entries carry the archetype voice → covered by the OWNER-REVIEW gate. */}
  <section class="ad-section reveal" style="--i: 4" aria-labelledby="ad-timeline">
    <h2 id="ad-timeline" class="ad-h2">How it grew</h2>
    <p class="ad-note">Anchored on versions, the way the system actually moved.</p>
    <ol class="ad-timeline">
      {/* Inverted: newest first. Data file stays chronological (easy to append);
          the present sits at the top and the rail flows down into the past. */}
      {
        [...ARTIFICER_TIMELINE].reverse().map((m) => (
          <li class="ad-tl">
            <div class="ad-tl__head">
              <span class="ad-tl__ver">{m.version}</span>
              <span class="ad-tl__date">{m.date}</span>
              <span class="ad-tl__phase">{m.phase}</span>
            </div>
            <h3 class="ad-tl__title">{m.title}</h3>
            <p class="ad-tl__body">{m.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  {/* ── How it was made — the meta-kicker. [OWNER-REVIEW: claude.ai/design tie-in
      + velocity framing; all dates evidence-backed from handoff bundles + git.] */}
  <section class="ad-section reveal" style="--i: 5" aria-labelledby="ad-made">
    <h2 id="ad-made" class="ad-h2">How it was made</h2>
    <div class="ad-prose">
      <p>
        Here's the part that closes the loop. Artificer was <b class="anchor">designed
        in claude.ai/design</b> — Anthropic's design tool — and handed off to Claude
        Code as <b class="anchor">handoff bundles</b>, the tool's own
        design-to-build workflow, pointed at itself. The early versions in the
        timeline above <em>are</em> those bundles; their file dates are the dates.
      </p>
      <p>
        The tool launched on <b class="anchor">17 April 2026</b>. Nine days later the
        system was solid enough to become a repo, and five weeks after that it was at
        v0.10.1 — themed editors, an Obsidian sister theme, and a versioned package.
        This page is built with it. It's tools all the way down.
      </p>
    </div>
    <div class="ad-flow" aria-label="Design to build pipeline">
      <span class="ad-flow__step">claude.ai/design</span>
      <span class="ad-flow__arrow" aria-hidden="true">→</span>
      <span class="ad-flow__step">handoff bundle</span>
      <span class="ad-flow__arrow" aria-hidden="true">→</span>
      <span class="ad-flow__step">Claude Code repo</span>
    </div>
  </section>
</BaseLayout>

{/* The vendored artificer.css applies page-wide (incl. BaseLayout's Header),
    and its .wordmark::after injects a "." — but the site's wordmark already
    carries the period in its text ("cameron."). Neutralise the pseudo-stop so
    the header doesn't render "cameron..". Our hero writes its own literal "." */}
<style is:global>
  .wordmark::after { content: none; }
</style>

<style>
  /* DOCUMENT surface. Page-scoped, tokens only. Structural px (rail width, node
     diameter) follow the system's own component-internal convention. */

  .ad-hero {
    margin: var(--s-sm) 0 var(--s-2xl);
  }
  .ad-hero__mark {
    /* Display + bold + large — whimsy doctrine #5. The mark, lowercase, stopped. */
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: clamp(2.5rem, 11vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .ad-hero__lede {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: clamp(1rem, 2.2vw, 1.2rem);
    line-height: 1.5;
    color: var(--fg-secondary);
    max-width: 40ch;
    margin: var(--s-md) 0 0;
    text-wrap: balance;
  }

  .ad-section {
    margin: var(--s-2xl) 0;
  }
  .ad-h2 {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--steel);
    margin: 0 0 var(--s-md);
    padding-bottom: var(--s-sm);
    border-bottom: 1px solid var(--border);
  }

  .ad-prose p {
    margin: 0 0 var(--s-md);
    line-height: 1.65;
    color: var(--fg);
  }
  .ad-prose p:last-child {
    margin-bottom: 0;
  }
  .ad-prose em {
    color: var(--fg);
    font-style: italic;
  }

  .ad-note {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--fg-secondary);
    margin: 0 0 var(--s-md);
  }

  /* Distilled rules — gold tick markers, no colour-only signalling. */
  .ad-rules {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-sm);
  }
  .ad-rules li {
    position: relative;
    padding-left: var(--s-lg);
    line-height: 1.5;
    color: var(--fg-secondary);
  }
  .ad-rules li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-family: var(--font-mono);
  }
  .ad-rules b {
    color: var(--fg);
    font-weight: 700;
  }

  /* Component demo blocks. */
  .ad-demo-block {
    margin: 0 0 var(--s-lg);
  }
  .ad-demo-block:last-child {
    margin-bottom: 0;
  }
  .ad-demo-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-secondary);
    margin-bottom: var(--s-sm);
  }
  .ad-card-title {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--fg);
    margin: 0 0 var(--s-xs);
  }

  /* Stat pattern — documented in the recipe table, shipped as a pattern, not a
     class, so it is reproduced here (tokens only): mono small-caps label, mono
     large tabular value, small delta whose colour reads change × polarity. */
  .ad-stat {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--s-md);
  }
  .ad-stat__label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-secondary);
  }
  .ad-stat__value {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 24px;
    line-height: 1.1;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
    margin-top: var(--s-xs);
  }
  .ad-stat__unit {
    font-size: 14px;
    color: var(--fg-secondary);
    margin-left: 2px;
  }
  .ad-stat__delta {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--success);
    margin-top: var(--s-xs);
  }
  .ad-stat__delta--worse {
    color: var(--urgent);
  }

  /* Timeline — a single vertical rail; one node per milestone. */
  .ad-timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ad-tl {
    position: relative;
    margin-left: 6px;
    padding: 0 0 var(--s-lg) var(--s-xl);
    border-left: 2px solid var(--border);
  }
  .ad-tl:last-child {
    border-left-color: transparent;
    padding-bottom: 0;
  }
  .ad-tl::before {
    content: "";
    position: absolute;
    left: -7px;
    top: 2px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent-fill);
    border: 2px solid var(--bg);
  }
  /* Newest-first: the present moment sits at the top and gets the brand node. */
  .ad-tl:first-child::before {
    background: var(--brand-purple);
  }
  .ad-tl__head {
    display: flex;
    align-items: baseline;
    gap: var(--s-sm);
    flex-wrap: wrap;
  }
  .ad-tl__ver {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .ad-tl__date {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--steel);
    font-variant-numeric: tabular-nums;
  }
  .ad-tl__phase {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-secondary);
  }
  .ad-tl__title {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.25;
    color: var(--fg);
    margin: var(--s-xs) 0 var(--s-xs);
  }
  .ad-tl__body {
    margin: 0;
    line-height: 1.6;
    color: var(--fg-secondary);
    max-width: 60ch;
  }

  /* Design→build pipeline — three mono chips joined by accent arrows. */
  .ad-flow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-sm);
    margin-top: var(--s-md);
  }
  .ad-flow__step {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--fg);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: var(--s-xs) var(--s-sm);
  }
  .ad-flow__arrow {
    color: var(--accent);
    font-family: var(--font-mono);
  }
</style>
