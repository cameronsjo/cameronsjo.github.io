---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '@cameronsjo/artificer/artificer.css';
import '@cameronsjo/artificer/whimsy.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    {/* Theme: applied pre-paint (no FOUC), shared with the rest of the
        Artificer system via the `artificer.theme` localStorage key. */}
    <script is:inline>
      (function () {
        var KEY = 'artificer.theme';
        function current() {
          return (
            document.documentElement.getAttribute('data-theme') ||
            (window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark')
          );
        }
        // Always set an explicit data-theme (default dark) so theme-dependent
        // CSS — including the whimsy layer — never falls into ambiguous
        // :not([data-theme]) / prefers-color-scheme branches.
        var initial = 'dark';
        try {
          var stored = localStorage.getItem(KEY);
          if (stored === 'light' || stored === 'dark') initial = stored;
        } catch (e) {}
        document.documentElement.setAttribute('data-theme', initial);

        function apply(next) {
          document.documentElement.setAttribute('data-theme', next);
          try {
            localStorage.setItem(KEY, next);
          } catch (e) {}
          document.querySelectorAll('[data-theme-label]').forEach(function (l) {
            l.textContent = next === 'light' ? 'Light' : 'Dark';
          });
        }

        function bind() {
          var init = current();
          document.querySelectorAll('[data-theme-label]').forEach(function (l) {
            l.textContent = init === 'light' ? 'Light' : 'Dark';
          });
          document
            .querySelectorAll('[data-theme-toggle]')
            .forEach(function (b) {
              if (b.dataset.themeBound === '1') return;
              b.dataset.themeBound = '1';
              b.addEventListener('click', function () {
                apply(current() === 'light' ? 'dark' : 'light');
              });
            });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', bind);
        } else {
          bind();
        }
      })();
    </script>
  </head>
  <body>
    <div class="topline" aria-hidden="true"></div>
    <div class="shell mx-auto flex min-h-screen max-w-2xl flex-col px-5">
      <Header />
      <main class="py-6">
        <slot />
      </main>
      <Footer />
    </div>
    {/* Cloudflare Web Analytics — cookieless, hostname-scoped to
        cameronsjo.github.io (one token covers the root, /blog,
        /agentic-harnesses, /spec-compare, and /understanding-claude-code).
        Token is public/write-only; no SRI hash because Cloudflare serves
        beacon.min.js mutable/unversioned. */}
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "9db7302de886402680e0838d0f35f7db"}'
    ></script>
    <script>
      // Seasonal footer greeting (artificer-whimsy). Sets window.Whimsy and
      // swaps [data-whimsy-greeting]: June → "happy pride" (vivid per-char
      // flow, the one line that never settles); off-season → the footer's own
      // inline line + glacial drift. Graceful without JS (plain inline text).
      //
      // whimsy.js is a side-effect-only module (exports nothing; just assigns
      // window.Whimsy), and the package now declares
      // sideEffects: ["*.css", "src/artificer-*.js"] — so a *static* `import`
      // gets tree-shaken away and the feature silently dies. A dynamic import
      // is never shaken: load it once and apply.
      (async () => {
        if (!window.Whimsy) await import('@cameronsjo/artificer/whimsy.js');
        window.Whimsy?.greeting();
      })();
    </script>
  </body>
</html>
