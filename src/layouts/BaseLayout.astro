---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '@cameronsjo/artificer/artificer.css';
import '@cameronsjo/artificer/whimsy.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    {/* Theme: applied pre-paint (no FOUC), shared with the rest of the
        Artificer system via the `artificer.theme` localStorage key. This
        inline bootstrap ONLY sets the initial data-theme attribute before
        first paint — default dark on a first visit (deliberately overriding
        prefers-color-scheme), or whatever mode was last pinned. Binding the
        toggle button (glyph injection, aria-label narration, the
        dark → light → auto cycle, live OS tracking in auto) is
        @cameronsjo/artificer/theme.js's job, loaded below.

        A first-time visitor (no stored key) MUST have 'dark' WRITTEN to the
        key here, not just applied in memory — theme.js's own storedMode()
        treats a missing key as 'auto', and as a deferred module it binds
        after this script paints. Without the write, the two disagree: a
        light-OS visitor paints dark, then flashes to light a few hundred ms
        later when theme.js reflects its own 'auto' read. Writing the key
        makes both sides agree on a pinned 'dark' from the same first frame. */}
    <script is:inline>
      (function () {
        var KEY = 'artificer.theme';
        var stored = null;
        try {
          stored = localStorage.getItem(KEY);
        } catch (e) {}
        var mode = stored === 'light' || stored === 'auto' ? stored : 'dark';
        if (stored === null) {
          try {
            localStorage.setItem(KEY, mode);
          } catch (e) {}
        }
        var theme =
          mode === 'auto'
            ? window.matchMedia &&
              window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark'
            : mode;
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <script>
      import '@cameronsjo/artificer/theme.js';
    </script>
  </head>
  <body>
    <div class="topline" aria-hidden="true"></div>
    <div class="shell mx-auto flex min-h-screen max-w-2xl flex-col px-5">
      <Header />
      <main class="py-6">
        <slot />
      </main>
      <Footer />
    </div>
    {/* Cloudflare Web Analytics — cookieless, hostname-scoped to
        cameronsjo.github.io (one token covers the root, /blog,
        /agentic-harnesses, /spec-compare, and /understanding-claude-code).
        Token is public/write-only; no SRI hash because Cloudflare serves
        beacon.min.js mutable/unversioned. */}
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "9db7302de886402680e0838d0f35f7db"}'
    ></script>
    <script>
      // Seasonal footer greeting (artificer-whimsy). Sets window.Whimsy and
      // swaps [data-whimsy-greeting]: June → "happy pride" (vivid per-char
      // flow, the one line that never settles); off-season → the footer's own
      // inline line + glacial drift. Graceful without JS (plain inline text).
      //
      // whimsy.js is a side-effect-only module (exports nothing; just assigns
      // window.Whimsy), and the package now declares
      // sideEffects: ["*.css", "src/artificer-*.js"] — so a *static* `import`
      // gets tree-shaken away and the feature silently dies. A dynamic import
      // is never shaken: load it once and apply.
      (async () => {
        if (!window.Whimsy) await import('@cameronsjo/artificer/whimsy.js');
        window.Whimsy?.greeting();
      })();
    </script>
  </body>
</html>
