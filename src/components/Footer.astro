---
import { SITE_TITLE, GITHUB_URL } from '../consts';

const year = new Date().getFullYear();
---

<footer class="colophon">
  {/* No .container wrapper: the page shell already sets the column and its
      inline padding, and .container would indent the footer a second time. */}
  <div class="colophon__spine">
    <span>© {year} {SITE_TITLE}</span>
    <span data-whimsy-greeting data-whimsy-greeting-class="whimsy--glacial">kindness is a choice.</span>
    <nav class="cluster">
      <a href={GITHUB_URL}>GitHub</a>
    </nav>
  </div>
  <p class="colophon__fine">
    Analytics by <a href="https://www.cloudflare.com/web-analytics/">Cloudflare Web Analytics</a> — cookieless,
    aggregate page views only; no cookies, no visitor profiles. Hosted on GitHub Pages, which logs visitor IP
    addresses per <a href="https://docs.github.com/site-policy/privacy-policies/github-general-privacy-statement"
    >GitHub's privacy statement</a>.
  </p>
</footer>
