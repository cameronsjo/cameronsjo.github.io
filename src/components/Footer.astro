---
import { SITE_TITLE, GITHUB_URL } from '../consts';

const year = new Date().getFullYear();
---

<footer class="colophon">
  <div class="container">
    <div class="colophon__spine">
      <span>© {year} {SITE_TITLE}</span>
      <span data-whimsy-greeting data-whimsy-greeting-class="whimsy--glacial">kindness is a choice.</span>
      <nav class="cluster">
        <a href={GITHUB_URL}>GitHub</a>
      </nav>
    </div>
  </div>
</footer>
