---
import { SITE_WORDMARK } from '../consts';
import { withBase } from '../utils';

// The three destinations live in the body launcher (a ⌘K-style command
// palette), so the header carries no nav links — only the brand wordmark and
// the theme toggle. Duplicating them here would be redundant chrome.
---

<header
  class="flex items-center justify-between gap-4 border-b py-5"
  style="border-color: var(--border)"
>
  <a
    href={withBase('')}
    class="wordmark whimsy whimsy--brand font-mono text-lg font-bold"
    data-wordmark
  >
    {SITE_WORDMARK}
  </a>
  <div class="flex items-center gap-5 text-sm">
    <button
      type="button"
      class="theme-toggle font-mono"
      data-theme-toggle
      aria-label="Toggle color theme"
    >
      <span class="dot" aria-hidden="true"></span>
      <span data-theme-label>Dark</span>
    </button>
  </div>
</header>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--s-xs);
    padding: 4px 10px;
    font-size: 12px;
    color: var(--fg-secondary);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }
  .theme-toggle:hover {
    color: var(--fg);
    border-color: var(--accent);
  }
  .theme-toggle .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }
</style>
