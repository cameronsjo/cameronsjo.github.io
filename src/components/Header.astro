---
import { SITE_WORDMARK } from '../consts';
import { withBase } from '../utils';

// The three destinations live in the body launcher (a ⌘K-style command
// palette), so the header carries no nav links — only the brand wordmark and
// the theme toggle. Duplicating them here would be redundant chrome.
---

<header
  class="flex items-center justify-between gap-4 border-b py-5"
  style="border-color: var(--border)"
>
  <a
    href={withBase('')}
    class="wordmark whimsy whimsy--brand font-mono text-lg font-bold"
    data-wordmark
  >
    {SITE_WORDMARK}
  </a>
  <div class="flex items-center gap-5 text-sm">
    <button
      type="button"
      class="theme-toggle theme-toggle--inline"
      data-theme-toggle
      aria-label="Toggle theme"
    ></button>
  </div>
</header>
